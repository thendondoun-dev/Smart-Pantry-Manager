<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Food Item"
            android:textColor="#FF2D75"
            android:textSize="30sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditFoodName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:hint="Food name"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="text" />

        <EditText
            android:id="@+id/etEditQuantity"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:hint="Quantity"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="numberDecimal" />

        <Spinner
            android:id="@+id/spinnerEditUnit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp" />

        <Spinner
            android:id="@+id/spinnerEditCategory"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp" />

        <EditText
            android:id="@+id/etEditExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:hint="Expiry date (YYYY-MM-DD)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="text" />

        <Button
            android:id="@+id/btnUpdateFood"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#FF2D75"
            android:text="UPDATE FOOD"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>